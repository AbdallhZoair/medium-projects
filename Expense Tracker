class Expense :
    History = []
    def __init__(self, amount, category, date):
        self.amount = amount
        self.category = category
        self.date = date

    def add_Expense(self, amount, category, date):
        while True:
            try:
                amount = int(input("Enter The amount : "))
                break
            except:
                print("you must enter number")

        while True:
            category = input("Enter The Category (Food, Fun, study, Travel) : ")
            if category in ["Food", "Fun", "study", "Travel"]:
                break
            else:
                print("You Must Choose One Of This (Food, Fun, study, Travel) \nTry Again")
                
        date = input("Enter The Date :  ")

        e1 = Expense(amount, category, date)
        self.History.append(e1)

    def display(self):
        for e in range(len(self.History)):
            print(f"The Amount is :{self.History[e].amount}")
            print(f"The Catedory is :{self.History[e].category}")
            print(f"The Date is :{self.History[e].date}")
            print("--------------------------")
    
