import os


def clear_screen():
    os.system("cls" if os.name == "nt" else "clear")


class Expense_Tracking:
    List_Catefory = ["Food", "Transportation", "Bills", "Entertainment"]
    history = []

    def Add_Expense(self):

        # إدخال المبلغ
        while True:
            try:
                self.Amount = float(input("Enter The Amount: "))
                if self.Amount < 0:
                    print("Wrong value (Must positive) , Try again: ")
                else:
                    break

            except:
                print("Must number , Try again: ")
        # إدخال التصنيغ
        self.Category = input(
            f"Chosse one of {Expense_Tracking.List_Catefory} Or Add new one : "
        ).capitalize()
        if self.Category not in Expense_Tracking.List_Catefory:
            Expense_Tracking.List_Catefory.append(self.Category)

        # إدخال التاريخ
        while True:
            try:
                year = int(input("enter the year: "))
                month = int(input("enter the month: "))
                day = int(input("enter the day: "))
                break
            except:
                print("must number bro , try again: ")
        self.Date = f"{year}/{month}/{day}"
        # إدخال الملاحظات
        self.Note = input("Enter note if you want(Enter to skip): ")
        if not self.Note:
            self.Note = "Empty"

        Expense = {
            "Amount": self.Amount,
            "Category": self.Category,
            "Date": self.Date,
            "Note": self.Note,
        }
        Expense_Tracking.history.append(Expense)
        print("\nExpense Added Successfully!\n")

    def Desplay_Expense(self):
        if not Expense_Tracking.history:
            print("Thier is no Expense yet...")
            return
        for i, user in enumerate(Expense_Tracking.history):
            print(f"Index: {i}")
            print(user["Amount"])
            print(user["Category"])
            print(user["Date"])
            print(user["Note"])
            print("_" * 20)

    def Search(self):
        search = []
        clear_screen()
        print("""\nSearch by: \n
                  1. Amount
                  2. Category
                  3. Date\n""")

        search_choice = input("Enter your choice: ")
        if not Expense_Tracking.history:
            print("Thier is no Expense yet...")
        else:
            if search_choice == '1':
                search_Amount = float(input("Enter the Amount to search: "))

                for x in Expense_Tracking.history:
                    if search_Amount == x["Amount"]:
                        search.append(x)

            elif search_choice == '2':
                search_Category = input("Enter the Caregory to search: ").capitalize()

                for x in Expense_Tracking.history:
                    if search_Category == x["Category"]:
                        search.append(x)

            elif search_choice == '3':
                search_Date = input("Enter the Date to search: ")

                for x in Expense_Tracking.history:
                    if search_Date == x["Date"]:
                        search.append(x)

            else:
                print("Wrong value , try again")
            if search:
                for item in search:
                    print(f"Amount is {item['Amount']}")
                    print(f"Category is {item['Category']}")
                    print(f"Date is {item['Date']}")
                    print(f"Note is {item['Note']}")
                    print("_" * 20)
            else:
                print("No matching expense found.")

    def Delete_Expense(self):
        clear_screen()
        if not Expense_Tracking.history:
            print("Thier is no Expense yet...")
            return

        # نعرض كل المصاريف مع رقم الـ إنديكس بتاعها
        self.Desplay_Expense()

        while True:
            try:
                delete_index = int(input("\nEnter the Index of the Expense you want to delete: "))
                if delete_index < 0 or delete_index >= len(Expense_Tracking.history):
                    print("Wrong Index , Try again")
                else:
                    break
            except:
                print("Must number , Try again")

        deleted = Expense_Tracking.history.pop(delete_index)
        print(f"\nDeleted: {deleted['Amount']} - {deleted['Category']} - {deleted['Date']}\n")

    def Edit_Expense(self):
        clear_screen()
        if not Expense_Tracking.history:
            print("Thier is no Expense yet...")
            return

        self.Desplay_Expense()

        while True:
            try:
                edit_index = int(input("\nEnter the Index of the Expense you want to edit: "))
                if edit_index < 0 or edit_index >= len(Expense_Tracking.history):
                    print("Wrong Index , Try again")
                else:
                    break
            except:
                print("Must number , Try again")

        expense = Expense_Tracking.history[edit_index]

        print("""\nWhat do you want to edit: \n
                  1. Amount
                  2. Category
                  3. Date
                  4. Note\n""")
        edit_choice = input("Enter your choice: ")

        if edit_choice == '1':
            while True:
                try:
                    new_Amount = float(input("Enter the new Amount: "))
                    if new_Amount < 0:
                        print("Wrong value (Must positive) , Try again")
                    else:
                        break
                except:
                    print("Must number , Try again")
            expense["Amount"] = new_Amount

        elif edit_choice == '2':
            new_Category = input(
                f"Chosse one of {Expense_Tracking.List_Catefory} Or Add new one : "
            ).capitalize()
            if new_Category not in Expense_Tracking.List_Catefory:
                Expense_Tracking.List_Catefory.append(new_Category)
            expense["Category"] = new_Category

        elif edit_choice == '3':
            while True:
                try:
                    year = int(input("enter the year: "))
                    month = int(input("enter the month: "))
                    day = int(input("enter the day: "))
                    break
                except:
                    print("must number bro , try again")
            expense["Date"] = f"{year}/{month}/{day}"

        elif edit_choice == '4':
            new_Note = input("Enter the new note (Enter to skip): ")
            expense["Note"] = new_Note if new_Note else "Empty"

        else:
            print("Wrong value , try again")
            return

        print("\nExpense Updated Successfully!\n")

    def Total_Expense(self):
        clear_screen()
        if not Expense_Tracking.history:
            print("Thier is no Expense yet...")
            return

        total = 0
        Category_Total = {}

        for x in Expense_Tracking.history:
            total += x["Amount"]
            # بنجمع المصاريف حسب كل تصنيف
            if x["Category"] not in Category_Total:
                Category_Total[x["Category"]] = 0
            Category_Total[x["Category"]] += x["Amount"]

        print(f"Total Expense: {total}\n")
        print("Total by Category:")
        for cat, amount in Category_Total.items():
            print(f"{cat}: {amount}")
        print("_" * 20)


def Main_Menu():
    Try = Expense_Tracking()

    while True:
        clear_screen()
        print("""\nExpense Tracking App\n
                  1. Add Expense
                  2. Display All Expenses
                  3. Search Expense
                  4. Delete Expense
                  5. Edit Expense
                  6. Total Expense
                  7. Exit\n""")

        choice = input("Enter your choice: ")

        if choice == '1':
            Try.Add_Expense()
        elif choice == '2':
            Try.Desplay_Expense()
        elif choice == '3':
            Try.Search()
        elif choice == '4':
            Try.Delete_Expense()
        elif choice == '5':
            Try.Edit_Expense()
        elif choice == '6':
            Try.Total_Expense()
        elif choice == '7':
            print("Bye!")
            break
        else:
            print("Wrong value , try again")

        input("\nPress Enter to continue...")


Main_Menu()
