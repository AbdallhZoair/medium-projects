class Expense_Tracking():
 List_Catefory = ["Food" , "Transportation" , "Bills" , "Entertainment"]
 history = []
 def Add_Expense(self):
        
    #إدخال المبلغ 
    while True:
     try:
       self.Amount = float(input("Enter The Amount")) 
       if self.Amount < 0: 
         print("Wrong value (Must positive) , Try again")
       else: break
      
     except : print("Must number , Try again")   
    # إدخال التصنيغ
    self.Category = input(f"Chosse one of {Expense_Tracking.List_Catefory} Or Add new one : ").capitalize()   
